node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# local file-backed user store (apps/server) — never real persistence, never committed
/apps/server/data/

# generated NNUE self-play data and Python training checkpoints — large, regeneratable
# from packages/ai/training/generate-selfplay.ts and train.py; only the final exported
# weight JSON under packages/ai/src/nnue-weights/ is committed.
/packages/ai/training/data/
/packages/ai/training/checkpoints/
*.pt

# Python venv/cache for packages/ai/training/'s offline-only training tooling
/packages/ai/training/.venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example

# Android signing keystore (apps/twa/README.md's one-time setup) — a real production
# signing key must never be committed; the CI workflow only ever reads it from GitHub
# Actions secrets (ANDROID_KEYSTORE_BASE64), never from a file in the repo.
*.keystore
*.jks

# editor metadata
.vscode/
.idea/
.project
.classpath
.settings/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# personal planning notes — not pushed, local only
/legacy/
/reference/
/docs/
/*.md
!/README.md

# deployment walkthrough — personal notes, may reference real hosting URLs; already
# covered by /*.md above, called out explicitly here per direct instruction: never push
/DEPLOYMENT.md

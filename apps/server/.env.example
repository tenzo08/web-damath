# Copy to .env for local development. Loaded automatically at startup via Node's native
# process.loadEnvFile() (index.ts) — no dotenv dependency, and no flag needed to run it.
# A missing .env is expected and silently ignored in production (Render injects these
# directly as real environment variables instead) — this file only matters locally.

# Required. Signs and verifies every login token (@fastify/jwt). Never falls back to a
# default — the server refuses to start without it (index.ts). Any random string is fine
# for local dev; Render's render.yaml generates a real one itself in production
# (generateValue: true) and you never see or set that one.
JWT_SECRET=any-random-string-for-local-dev

# Once the Postgres/Prisma migration lands, this must be a real Postgres connection
# string (e.g. from Neon — see DEPLOYMENT.md's Step 1 — looks like
# postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require). Until
# then it's unused: left as this placeholder or unset, the server falls back to
# FileUserStore/FileGameStore/FileTournamentStore under DATA_DIR below. Treat this like
# JWT_SECRET — never commit a real value.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional. Where the JSON file stores live when DATABASE_URL isn't set. Defaults to
# apps/server/data (index.ts) — only override if you want games/users/tournaments
# written somewhere else, e.g. a mounted persistent disk in production.
# DATA_DIR=./data

# Optional. Port the HTTP/WS server listens on. Defaults to 3001 (index.ts) — matches
# apps/web/.env.example's default VITE_SERVER_URL.
# PORT=3001

# Optional. How long an issued login token stays valid, in @fastify/jwt's `expiresIn`
# format (e.g. 30d, 12h, 1h). Defaults to 30d (app.ts). Since a token can't be
# individually revoked short of rotating JWT_SECRET (which logs out everyone), a shorter
# value here bounds how long a leaked token stays useful.
# JWT_EXPIRES_IN=30d

# Optional. Comma-separated list of origins allowed to call the REST/WS API
# cross-origin (@fastify/cors). Left unset, the server reflects whatever origin asks
# (app.ts's `corsOrigin ?? true`) — fine for local dev, not for production. Set this to
# your deployed web app's exact origin once it's known (DEPLOYMENT.md's Step 4).
# CORS_ORIGIN=http://localhost:5173

# Optional. docs/AI_OPPONENT.md §9 — matchmaking's bot-fallback behavior when no human
# opponent is available. Defaults: enabled, tier "steady", 90-second wait.
# QUEUE_BOT_ENABLED=true
# QUEUE_BOT_TIER=steady
# QUEUE_BOT_TIMEOUT_MS=90000

# Optional. A Google Cloud OAuth Client ID (console.cloud.google.com -> APIs & Services
# -> Credentials -> Create Credentials -> OAuth client ID -> Web application). Not a
# secret -- it's meant to be public, the same value also goes in apps/web's
# VITE_GOOGLE_CLIENT_ID. Verifies a Google ID token's `aud` claim server-side
# (auth/routes.ts's /auth/google). Google Sign-In is the *only* way into this app
# (KNOWLEDGE.md) -- left unset, nobody can sign in at all.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional. A shared secret that unlocks POST /auth/dev-login (auth/routes.ts) -- mints
# a real session for any existing account by email, entirely bypassing Google. Exists so
# you can seed and test accounts (e.g. a dummy tournament bracket) that can't reasonably
# go through a real Google sign-in. Left unset, the route isn't even registered. Never
# wired into the web client -- use it directly, e.g.
# curl -X POST http://localhost:3001/auth/dev-login -H "Content-Type: application/json" \
#   -d '{"email":"dummy1@damath.test","secret":"<this value>"}'
# Generate a real one with: openssl rand -hex 32
# DEV_LOGIN_SECRET=change-me-to-a-long-random-string

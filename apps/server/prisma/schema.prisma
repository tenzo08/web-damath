// Mirrors the existing store shapes exactly (auth/store.ts's User, game/store.ts's
// PersistedGame, tournament/store.ts's PersistedTournament) so the Prisma-backed store
// implementations are a drop-in swap behind the same UserStore/GameStore/
// TournamentStore interfaces — nothing outside each store.ts file needs to change
// (KNOWLEDGE.md, "Scoped-down persistence: a JSON file, not Postgres+Prisma yet").
//
// `players`/`participants`/`bracket`/`moveHistory` stay JSON blobs, same as the file
// stores, rather than being fully normalized into relations — this is still a small
// classroom app, and normalizing them is a bigger, separate decision than "give this
// data a real database."

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved the connection URL out of this file and into prisma.config.ts —
// this block only declares the provider now (confirmed against the actual CLI error
// when the old url/directUrl fields were still here: P1012, "no longer supported").
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  /// Lowercased mirror of displayName, maintained by the app on every write (never set
  /// directly, never exposed to a client) -- Postgres has no native case-insensitive
  /// unique constraint without an extension (citext) or a functional index, and this
  /// keeps the schema a plain declarative `@unique`, the same normalize-before-storage
  /// convention `email` already uses. See auth/store.ts, auth/routes.ts.
  displayNameLower String @unique
  /// Elo rating, starting value 1200 — see rating/elo.ts. Added directly on Postgres
  /// rather than first on the file store, since the migration landed before the rank
  /// system's storage did.
  rating       Int      @default(1200)
  /// One of auth/avatars.ts's fixed emoji set, or null for the default initial-letter
  /// circle (ProfileButton.tsx/SettingsModal.tsx). Validated server-side against that
  /// same list on PATCH /auth/me — never an arbitrary client-supplied string.
  avatarEmoji  String?
  /// Set once a verify-email token is successfully redeemed. Not currently enforced
  /// anywhere -- see auth/store.ts.
  emailVerified        Boolean   @default(false)
  /// SHA-256 of the live token, never the raw token -- see auth/actionTokens.ts.
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  verifyTokenHash      String?
  verifyTokenExpiresAt DateTime?
  /// Google's stable per-account `sub` claim, set the first time this account signs in
  /// with Google (auth/routes.ts's /auth/google) -- null for an account that's only
  /// ever used email/password. Nullable + @unique, not @unique alone: Postgres treats
  /// every NULL as distinct under a unique constraint, so any number of non-Google
  /// accounts can coexist with this column unset.
  googleId     String?  @unique
  /// How many bot games this account has finished -- see rating/elo.ts's
  /// PLACEMENT_GAMES_REQUIRED. Starts at 0.
  placementGamesPlayed Int @default(0)
  createdAt    DateTime @default(now())

  @@index([resetTokenHash])
  @@index([verifyTokenHash])
}

model Game {
  id              String   @id @default(uuid())
  variantId       String
  whitePlayerId   String?
  blackPlayerId   String?
  opponentType    String
  botTier         String?
  /// Move<V>[], JSON-boundary typed the same way the file store's `moveHistory: readonly
  /// unknown[]` already is — see game/store.ts.
  moveHistory     Json
  status          String
  resignedBy      String?
  /// A real draw the players agreed to (draw offer + acceptance), distinct from a
  /// score-tie or resignation — see game/room.ts.
  drawnByAgreement Boolean @default(false)
  tournamentId    String?
  tournamentRound Int?
  tournamentIndex Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([whitePlayerId])
  @@index([blackPlayerId])
}

model Tournament {
  id            String    @id @default(uuid())
  name          String
  variantId     String
  creatorUserId String
  joinCode      String    @unique
  /// string[] — participant user ids, in join order.
  participants  Json
  /// Bracket | null (bracket.ts) — null until the tournament starts.
  bracket       Json?
  status        String
  startTime     DateTime?
  endTime       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// A user reporting another user for abuse -- moderation/reporting floor, no review UI
/// yet (this app has no admin/role concept to gate one behind); stored durably so a
/// real admin can query it directly. See game/moderation.ts.
model Report {
  id               String   @id @default(uuid())
  reporterUserId   String
  reportedUserId   String
  reason           String
  /// A room id, if the report was filed from a specific game -- null for a report filed
  /// from match history against a game that's since had its own row deleted, or any
  /// other context-free report.
  roomId           String?
  createdAt        DateTime @default(now())

  @@index([reportedUserId])
}

/// A one-directional block: `blockerUserId` doesn't want to be matched with
/// `blockedUserId` again. Checked both directions when pairing two users for
/// matchmaking (rooms.ts) -- either party having blocked the other is enough to skip
/// the pairing.
model Block {
  id             String   @id @default(uuid())
  blockerUserId  String
  blockedUserId  String
  createdAt      DateTime @default(now())

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

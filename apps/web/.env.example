# Copy to .env.local for local development against a non-default server URL.
# Baked in at build time (Vite env vars aren't a runtime concern) — a deployed build
# needs this set correctly when it's built, e.g. via Vercel's project environment
# variables, not changeable after the fact without a rebuild.
VITE_SERVER_URL=http://localhost:3001

# Optional. A Google Cloud OAuth Client ID (console.cloud.google.com -> APIs & Services
# -> Credentials). Not a secret -- Client IDs are meant to be public, embedded straight
# into client-side JS. Must match the deployed server's GOOGLE_CLIENT_ID exactly, same
# OAuth client both sides. Left unset, the "Sign in with Google" button isn't shown.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
